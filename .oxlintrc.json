{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "env": { "builtin": true },
  "ignorePatterns": ["node_modules", "site/dist"],
  "rules": {
    "no-console": "off",
    "eslint/no-await-in-loop": "off"
  }
}
